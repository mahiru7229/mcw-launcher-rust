{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mahiru7229/mcw-launcher-rust/main/schemas/launcher-settings.schema.json",
  "title": "MCW Launcher Global Settings",
  "description": "Schema for config/launcher_settings.json in MCW Launcher: Rust Edition.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI for editor autocomplete and validation."
    },
    "theme": {
      "type": "string",
      "enum": ["violet", "emerald", "crimson", "midnight", "slate"]
    },
    "language": {
      "type": "string",
      "description": "Locale code, e.g. en-US or vi-VN."
    },
    "show_snapshots": { "type": "boolean" },
    "debug_mode": { "type": "boolean" },
    "download_concurrency": { "type": "integer", "minimum": 0 },
    "show_content_descriptions": { "type": "boolean" },
    "modrinth_include_beta": { "type": "boolean" },
    "modrinth_include_alpha": { "type": "boolean" },
    "default_min_memory": { "type": "integer", "minimum": 128 },
    "default_max_memory": { "type": "integer", "minimum": 256 },
    "default_width": { "type": "integer", "minimum": 320 },
    "default_height": { "type": "integer", "minimum": 240 },
    "default_fullscreen": { "type": "boolean" },
    "notification_timeout_secs": { "type": "integer", "minimum": 0 },
    "auto_check_updates": { "type": "boolean" },
    "auto_update_v110_migrated": { "type": "boolean" },
    "v121_defaults_migrated": { "type": "boolean" },
    "update_channel": { "type": "string", "enum": ["stable", "beta"] },
    "first_run_completed": { "type": "boolean" },
    "discord_rpc_enabled": { "type": "boolean" },
    "discord_client_id": { "type": "string" },
    "unused_version_retention_days": { "type": "integer", "minimum": 0 },
    "custom_accent_hex": { "type": "string" },
    "motion_mode": { "type": "string", "enum": ["full", "reduced", "off"] },
    "download_limit_mbps": { "type": "number", "minimum": 0 },
    "prefer_dedicated_gpu": { "type": "boolean" },
    "minimize_on_launch": { "type": "boolean" },
    "remember_window_size": { "type": "boolean" },
    "window_size_customized": { "type": "boolean" },
    "window_width": { "type": "number", "minimum": 0 },
    "window_height": { "type": "number", "minimum": 0 },
    "default_java_path": { "type": "string" },
    "modrinth_failure_policy": { "type": "string", "enum": ["block", "warn", "ignore"] },
    "curseforge_failure_policy": { "type": "string", "enum": ["block", "warn", "ignore"] },
    "forge_preflight_failure_policy": { "type": "string", "enum": ["block", "warn", "ask", "ignore"] },
    "background_enabled": { "type": "boolean" },
    "background_image_path": { "type": "string" },
    "panel_opacity": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
    "background_dim": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "window_size_schema_version": { "type": "integer", "minimum": 0 },
    "custom_font_family": { "type": "string" },
    "ui_scale": { "type": "number", "minimum": 0.5, "maximum": 2.5 },
    "font_size": { "type": "number", "minimum": 9.0, "maximum": 24.0 },
    "download_segments_per_file": { "type": "integer", "minimum": 1, "maximum": 16 },
    "auto_cleanup_reminders": { "type": "boolean" },
    "junk_retention_days": { "type": "integer", "minimum": 1 },
    "junk_reminder_snooze_until": { "type": "integer", "minimum": 0 },
    "home_view_mode": { "type": "string", "enum": ["workspace", "grid", "list"] },
    "default_home_view_mode": {
      "type": "string",
      "enum": ["grid", "workspace"],
      "description": "Default Home view mode applied when opening MCW Launcher."
    },
    "home_sort_by": { "type": "string", "enum": ["last_played", "name", "playtime", "version"] },
    "proxy_mode": { "type": "string", "enum": ["none", "system", "manual"] },
    "proxy_host": { "type": "string" },
    "proxy_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "proxy_username": { "type": "string" },
    "proxy_password": { "type": "string" },
    "auto_open_logs_on_crash": { "type": "boolean" },
    "mitigate_minecraft2shell": {
      "type": "boolean",
      "description": "Attach MCW Security Agent to force FT_LOAD_NO_HINTING on FreeType (1.20.5+), mitigating the bikini/minecraft2shell RCE vulnerability."
    },
    "warn_auto_accept_server_resource_packs": {
      "type": "boolean",
      "description": "Warn before launch if servers.dat contains entries with acceptTextures enabled (auto-accept server resource packs)."
    }
  }
}
